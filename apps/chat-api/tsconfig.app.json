{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "outDir": "../../dist/apps/chat-api",
    "rootDir": "../..",
    "types": ["node"],
    "paths": {
      "@chat-monorepo/shared": ["../../libs/shared/src/index.ts"]
    }
  },
  "exclude": ["**/*.spec.ts"],
  "include": [
    "src/**/*.ts",
    "../../libs/shared/src/**/*.ts"
  ],
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
