# Environment Variables Configuration
NODE_ENV=development
PORT=3000

# AI Provider API Keys
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Firestore (chat thread / user persistence, via firebase-admin).
# Local dev: either set FIREBASE_SERVICE_ACCOUNT_KEY (JSON-stringified
# service-account key), or GOOGLE_APPLICATION_CREDENTIALS pointing at a
# downloaded key file (Firebase Console > Project Settings > Service
# Accounts > Generate new private key). On Cloud Run, leave both unset -
# Application Default Credentials use the service's own identity
# automatically (grant it the "Cloud Datastore User" IAM role).
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#
# Only needed if you created a non-default named Firestore database
# (e.g. via the GCP console "Create Database" flow) instead of using
# the database literally named "(default)".
# FIRESTORE_DATABASE_ID=nexus-ai

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Signs the app's OWN 7-day session token, issued once at sign-in via
# POST /api/auth/session (see auth.middleware.ts). This is what every
# authenticated request verifies from then on - NOT Google's own ~1hr
# token - so a real, persistent value is required in production. If unset,
# a random one is generated per-process, which invalidates every session
# on each restart/deploy; fine for local dev, not for production.
# Generate one with: openssl rand -hex 32
APP_SESSION_SECRET=your_random_64_char_hex_secret_here

# Comma-separated list of allowed frontend origins for CORS.
# In production, set to the deployed chat-client URL(s), e.g.
# https://chat-client-xxxxx-uc.a.run.app
ALLOWED_ORIGIN=*

