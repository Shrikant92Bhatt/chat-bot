# Environment Variables Configuration
NODE_ENV=development
PORT=3000

# AI Provider API Keys
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Admin SDK Configuration (JSON Stringified Service Account)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
SKIP_AUTH=false

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Comma-separated list of allowed frontend origins for CORS.
# In production, set to the deployed chat-client URL(s), e.g.
# https://chat-client-xxxxx-uc.a.run.app
ALLOWED_ORIGIN=*

# Postgres connection for chat thread / user persistence.
# Local dev: either set DATABASE_URL, or leave unset and use the discrete
# DB_* vars below (defaults to localhost:5432/nexusai).
# DATABASE_URL=postgres://postgres:password@localhost:5432/nexusai
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=nexusai

# Cloud Run + Cloud SQL Auth Proxy sidecar (production only): set this to
# PROJECT:REGION:INSTANCE and the app connects over the mounted unix socket
# instead of DB_HOST/DB_PORT. See DEPLOY_COMMANDS.md.
# INSTANCE_CONNECTION_NAME=chat-bot-505613:asia-south1:nexusai-pg
