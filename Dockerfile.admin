# ==========================================
# Stage 1: Build Angular Static Application
# ==========================================
# Mirrors Dockerfile.client exactly - same base image, same npm ci, same NGINX
# runtime, same runtime-config entrypoint. Only the Nx target and the copied
# dist path differ, so the two frontends stay operationally identical.
FROM node:24-alpine AS builder

WORKDIR /app

# Copy monorepo configuration files
COPY package.json package-lock.json nx.json tsconfig.base.json ./

# Install exact locked versions (npm install without the lockfile can
# re-resolve to newer transitive deps with incompatible peer requirements)
RUN npm ci

# Copy source code
COPY apps ./apps
COPY libs ./libs

# Build production Angular admin console with expanded memory limit
RUN NODE_OPTIONS="--max-old-space-size=4096" npx nx build admin-analytics

# ==========================================
# Stage 2: Serve via High-Performance NGINX
# ==========================================
FROM nginx:alpine AS runner

# Copy custom NGINX config (shared with chat-client - same SPA fallback,
# same cache headers; the Angular build hashes its filenames the same way)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled Angular artifacts
COPY --from=builder /app/dist/apps/admin-analytics/browser /usr/share/nginx/html

# Regenerates assets/env.js from the API_URL env var at container startup
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/docker-entrypoint.sh"]
