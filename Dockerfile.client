# ==========================================
# Stage 1: Build Angular Static Application
# ==========================================
FROM node:lts-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* nx.json tsconfig.base.json ./
RUN npm ci

COPY apps ./apps
COPY libs ./libs

# Build production Angular client
RUN npx nx build chat-client

# Ensure build artifacts exist at target location
RUN mkdir -p /app/dist/apps/chat-client/browser && \
    cp -r /app/dist/apps/chat-client/* /app/dist/apps/chat-client/browser/ || true

# ==========================================
# Stage 2: Serve via High-Performance NGINX
# ==========================================
FROM nginx:alpine AS runner

# Copy custom NGINX config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled Angular browser artifacts
COPY --from=builder /app/dist/apps/chat-client /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
