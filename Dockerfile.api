# ==========================================
# Stage 1: Build Workspace & Dependencies
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy monorepo configuration files
COPY package.json package-lock.json nx.json tsconfig.base.json ./

# Install exact locked versions (npm install without the lockfile can
# re-resolve to newer transitive deps with incompatible peer requirements)
RUN npm ci

# Copy full source code
COPY apps ./apps
COPY libs ./libs

# Build the backend application via Nx
RUN NODE_OPTIONS="--max-old-space-size=4096" npx nx build chat-api

# ==========================================
# Stage 2: Production Execution Image
# ==========================================
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 expressjs

# Copy built dist files from builder
COPY --from=builder /app/dist/apps/chat-api ./dist/apps/chat-api
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

USER expressjs

EXPOSE 8080

CMD ["sh", "-c", "if [ -f dist/apps/chat-api/apps/chat-api/src/main.js ]; then node dist/apps/chat-api/apps/chat-api/src/main.js; else node dist/apps/chat-api/main.js; fi"]
