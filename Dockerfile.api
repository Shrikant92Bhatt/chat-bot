# ==========================================
# Stage 1: Build Workspace & Dependencies
# ==========================================
FROM node:24-alpine AS builder

WORKDIR /app

# Copy monorepo configuration files
COPY package.json package-lock.json nx.json tsconfig.base.json ./

# Install exact locked versions (npm install without the lockfile can
# re-resolve to newer transitive deps with incompatible peer requirements)
RUN npm ci

# Copy full source code
COPY apps ./apps
COPY libs ./libs

# Build the backend application via Nx
RUN NODE_OPTIONS="--max-old-space-size=4096" npx nx build chat-api

# ==========================================
# Stage 2: Production Execution Image
# ==========================================
FROM node:24-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 expressjs

# Copy built dist files from builder
COPY --from=builder /app/dist/apps/chat-api ./dist/apps/chat-api
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# apps/chat-api imports @chat-monorepo/shared (libs/shared) as a bare
# specifier - tsc leaves that require() as-is at compile time (it doesn't
# bundle), so it only resolves at runtime if something real sits at
# node_modules/@chat-monorepo/shared. Nx already builds libs/shared as part
# of `nx build chat-api` (targetDefaults.build.dependsOn: ["^build"] in
# nx.json), producing dist/libs/shared with its own package.json - it just
# was never copied into the runtime image, which crashed the container on
# boot the moment any file imported a real value (not just a type) from
# that package (see services/model-config.service.ts's SELECTABLE_MODELS
# import - type-only imports get elided by tsc so they never surfaced this).
COPY --from=builder /app/dist/libs/shared ./node_modules/@chat-monorepo/shared

USER expressjs

EXPOSE 8080

CMD ["sh", "-c", "if [ -f dist/apps/chat-api/apps/chat-api/src/main.js ]; then node dist/apps/chat-api/apps/chat-api/src/main.js; else node dist/apps/chat-api/main.js; fi"]
