# Copy to terraform.tfvars (gitignored) and fill in real values before
# `terraform plan`. Do not commit terraform.tfvars.

project_id = "your-gcp-project-id-staging"
region     = "asia-south1"

bucket_name            = "nexusai-generated-images-staging"
firestore_database_id  = "nexus-ai-staging"

# Leave unset to default to ":latest" in the Terraform-managed Artifact
# Registry repo, or pin explicitly, e.g.:
# api_image    = "asia-south1-docker.pkg.dev/your-gcp-project-id-staging/chat-repo/chat-api:latest"
# client_image = "asia-south1-docker.pkg.dev/your-gcp-project-id-staging/chat-repo/chat-client:latest"

google_client_id = "your-oauth-client-id.apps.googleusercontent.com"
allowed_origin    = "*"

enable_redis = false
