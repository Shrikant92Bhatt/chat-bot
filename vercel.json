{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "chat-client": {
      "root": ".",
      "framework": "angular",
      "buildCommand": "npm run build:vercel",
      "outputDirectory": "dist/apps/chat-client/browser",
      "rewrites": [
        {
          "source": "/((?!assets/|.*\\..*).*)",
          "destination": "/index.html"
        }
      ]
    },
    "chat-api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "api/index.ts",
      "buildCommand": "echo 'chat-api: no build step needed - api/index.ts is bundled directly from source by the function builder'",
      "bindings": [
        {
          "type": "service",
          "service": "sandbox-service",
          "format": "url",
          "env": "CODE_SANDBOX_SERVICE_URL"
        }
      ],
      "functions": {
        "api/index.ts": {
          "maxDuration": 60
        }
      }
    },
    "sandbox-service": {
      "root": "infra/sandbox-service",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "chat-api"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "chat-api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "chat-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "chat-client"
      }
    }
  ]
}
