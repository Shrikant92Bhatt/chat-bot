{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "angular",
      "buildCommand": "npm run build:vercel",
      "outputDirectory": "dist/apps/chat-client/browser",
      "rewrites": [{ "source": "/((?!assets/|.*\\..*).*)", "destination": "/index.html" }]
    },
    "api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "api/index.ts",
      "functions": {
        "api/index.ts": { "maxDuration": 60 }
      },
      "bindings": [
        { "type": "service", "service": "sandbox", "format": "url", "env": "CODE_SANDBOX_SERVICE_URL" }
      ]
    },
    "sandbox": {
      "root": "infra/sandbox-service",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/.well-known/(.*)", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
