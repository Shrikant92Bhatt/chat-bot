{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "chat-client": {
      "root": ".",
      "framework": "angular",
      "buildCommand": "npm run build:vercel",
      "outputDirectory": "dist/apps/chat-client/browser"
    },
    "chat-api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "api/index.ts",
      "maxDuration": 60,
      "bindings": [
        {
          "type": "service",
          "service": "sandbox-service",
          "format": "url",
          "env": "CODE_SANDBOX_SERVICE_URL"
        }
      ]
    },
    "sandbox-service": {
      "root": "infra/sandbox-service",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "chat-api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "chat-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "chat-client"
      }
    }
  ]
}