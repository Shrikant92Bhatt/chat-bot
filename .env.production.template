# =============================================================================
# NexusAI - production environment variables (Vercel)
#
# How to use:
#   1. Run `bash scripts/generate-secrets.sh` and paste its output over the
#      <generate> placeholders below.
#   2. Fill the <...> placeholders (where each value comes from is noted).
#   3. Vercel -> Project -> Settings -> Environment Variables -> paste this whole
#      file into the first "Key" field (Vercel splits .env content into rows).
#      Target: Production (and Preview if you want preview deploys to work).
#   4. Redeploy.
#
# Never commit the filled-in copy. This template contains no secrets.
# Full reference: docs/ENV_VARIABLES.md
# =============================================================================

# ---------- REQUIRED: core app ----------------------------------------------

# LLM gateway (chat, web search, image generation). openrouter.ai/keys
OPENROUTER_API_KEY=<from GCP Secret Manager: OPENROUTER_API_KEY>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Summaries, memory extraction, suggestions, research planner, fallback chat.
# aistudio.google.com/apikey
GEMINI_API_KEY=<from GCP Secret Manager: GEMINI_API_KEY>

# Google Sign-In (public value, not a secret).
GOOGLE_CLIENT_ID=953232172604-iukeghd5021k56htjq7ep332bvtvppot.apps.googleusercontent.com

# Signs NexusAI session tokens. Reuse the GCP value to keep users signed in.
APP_SESSION_SECRET=<from GCP Secret Manager: APP_SESSION_SECRET>

# Firestore + Cloud Storage. Vercel has no GCP identity, so a key is required:
# GCP -> IAM -> Service Accounts -> (Cloud Run's account) -> Keys -> Add key -> JSON.
# Paste the whole JSON on ONE line. Needs "Cloud Datastore User" + bucket access.
FIREBASE_SERVICE_ACCOUNT_KEY=<one-line service-account JSON>
FIRESTORE_DATABASE_ID=nexus-ai
GCS_BUCKET_NAME=nexusai-generated-images

# ---------- REQUIRED: connectors (Settings -> Connectors) -------------------

CONNECTORS_ENABLED=true
# Your deployment URL, no trailing slash (custom domain if you attach one).
PUBLIC_BASE_URL=https://<your-project>.vercel.app
CONNECTOR_ENCRYPTION_KEY=<generate>

# GitHub App: github.com/settings/apps/new
#   Callback URL: https://<your-project>.vercel.app/api/v1/connectors/oauth/callback
#   Repository permissions (read-only): Metadata, Contents, Issues, Pull requests, Actions
GITHUB_CONNECTOR_CLIENT_ID=<GitHub App -> Client ID>
GITHUB_CONNECTOR_CLIENT_SECRET=<GitHub App -> Generate a new client secret>
GITHUB_CONNECTOR_MODE=app

# Gmail: a NEW Google OAuth client (not the sign-in one), Gmail API enabled.
#   console.cloud.google.com/apis/credentials -> Create OAuth client -> Web app
#   Authorized redirect URI: https://<your-project>.vercel.app/api/v1/connectors/oauth/callback
GMAIL_CONNECTOR_CLIENT_ID=<new OAuth client ID>
GMAIL_CONNECTOR_CLIENT_SECRET=<new OAuth client secret>

# Approval-gated writes (create issue/comment, draft/send email, paper orders).
CONNECTOR_WRITES_ENABLED=false

# ---------- OPTIONAL: ChatGPT app (MCP server at /api/mcp) -------------------

MCP_SERVER_ENABLED=false
# Must differ from APP_SESSION_SECRET, or MCP stays disabled.
MCP_OAUTH_SIGNING_SECRET=<generate>

# ---------- code interpreter tool -------------------------------------------
# Do NOT set CODE_SANDBOX_SERVICE_URL on Vercel: the api service's binding to
# the internal `sandbox` service injects it (see vercel.json).
# Optional extra check between the two services (both read the same variable):
# CODE_SANDBOX_SERVICE_SECRET=<generate>
